# Site URL (canonical non-www domain)
NEXT_PUBLIC_SITE_URL=https://convertmastery.com

# Copy to .env.local and add your key
# Get a key at https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Geocoding API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Free AI text tools (Paraphraser, Summarizer, Email Writer)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: GROQ_MODEL=llama-3.1-8b-instant
# Optional: AI_DAILY_LIMIT=20
